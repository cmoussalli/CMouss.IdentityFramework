@namespace CMouss.IdentityFramework.BlazorUI.Shared
@inject IJSRuntime JS

@* Shows a key / secret / token, masked by default, with reveal and copy. *@
<div class="input-group input-group-sm idf-secret">
    <input type="text" class="form-control font-monospace" readonly value="@Displayed" />
    @if (IDFBlazorUIAdminConfig.AllowRevealSecrets)
    {
        <button type="button" class="btn btn-outline-secondary" title="@(revealed ? "Hide" : "Reveal")" @onclick="Toggle">
            @(revealed ? "Hide" : "Show")
        </button>
    }
    <button type="button" class="btn btn-outline-secondary" title="Copy" @onclick="CopyAsync">Copy</button>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";

    private bool revealed;

    private string Displayed
    {
        get
        {
            if (string.IsNullOrEmpty(Value)) { return ""; }
            if (revealed && IDFBlazorUIAdminConfig.AllowRevealSecrets) { return Value; }
            if (Value.Length <= 8) { return new string('*', Value.Length); }
            return Value.Substring(0, 4) + new string('*', 10) + Value.Substring(Value.Length - 4);
        }
    }

    private void Toggle()
    {
        revealed = !revealed;
    }

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Value);
        }
        catch (Exception)
        {
            //Clipboard is unavailable over plain http or on unsupported browsers
        }
    }
}
