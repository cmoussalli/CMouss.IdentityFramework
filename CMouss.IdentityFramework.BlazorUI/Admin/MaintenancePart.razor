@namespace CMouss.IdentityFramework.BlazorUI.Admin
@inherits IdfAdminComponentBase

@if (!IsReady)
{
    <div class="text-muted p-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>
}
else if (!IsAuthorized)
{
    <div class="alert alert-warning">You are not allowed to open this screen.</div>
}
else
{
    <IdfAlerts Errors="Errors" SuccessMessage="@SuccessMessage" OnDismiss="ClearMessages" />

    <IdfPanel Title="Overview" IsLoading="IsLoading">
        <Toolbar>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync">Refresh</button>
        </Toolbar>
        <ChildContent>
            <div class="row g-2">
                @foreach (KeyValuePair<string, int> c in counters)
                {
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="fs-4 fw-semibold">@c.Value</div>
                            <div class="small text-muted">@c.Key</div>
                        </div>
                    </div>
                }
            </div>
        </ChildContent>
    </IdfPanel>

    <IdfPanel Title="Configuration" Description="Read only, set through IDFManager.Configure at startup.">
        <ChildContent>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td class="text-muted" style="width:280px;">Database type</td><td>@IDFManager.DatabaseType</td></tr>
                        <tr><td class="text-muted">DB life cycle</td><td>@IDFManager.DBLifeCycle</td></tr>
                        <tr><td class="text-muted">Authentication backend</td><td>@IDFManager.AuthenticationBackend</td></tr>
                        <tr><td class="text-muted">Token validation mode</td><td>@IDFManager.TokenValidationMode</td></tr>
                        <tr><td class="text-muted">Token encryption key</td><td class="font-monospace">@Mask(IDFManager.TokenEncryptionKey ?? "")</td></tr>
                        <tr><td class="text-muted">Default token lifetime</td><td>@Describe(IDFManager.TokenDefaultLifeTime)</td></tr>
                        <tr><td class="text-muted">Default app access lifetime</td><td>@Describe(IDFManager.AppAccessDefaultLifeTime)</td></tr>
                        <tr><td class="text-muted">Allow multiple sessions</td><td>@IDFManager.AllowUserMultipleSessions</td></tr>
                        <tr><td class="text-muted">New users are active</td><td>@IDFManager.IsActiveByDefault</td></tr>
                        <tr><td class="text-muted">New users are locked</td><td>@IDFManager.IsLockedByDefault</td></tr>
                        <tr><td class="text-muted">Unique app title across users</td><td>@IDFManager.MaintainUniqueAppTitleAcrossAllUsers</td></tr>
                        <tr><td class="text-muted">Default page size</td><td>@IDFManager.DefaultListPageSize</td></tr>
                        <tr><td class="text-muted">Id generator level</td><td>@IDFManager.IDGeneratorLevel</td></tr>
                        <tr><td class="text-muted">Administrator role</td><td>@IDFManager.AdministratorRoleName (@IDFManager.AdministratorRoleId)</td></tr>
                        <tr><td class="text-muted">Administrator user</td><td>@IDFManager.AdministratorUserName</td></tr>
                        @if (IDFManager.AuthenticationBackend == AuthenticationBackend.LDAP)
                        {
                            <tr><td class="text-muted">LDAP server</td><td>@IDFManager.LDAP_AD_Server</td></tr>
                            <tr><td class="text-muted">LDAP domain</td><td>@IDFManager.LDAP_AD_Domain_Name</td></tr>
                            <tr><td class="text-muted">LDAP base DN</td><td>@IDFManager.LDAP_AD_BaseDN</td></tr>
                            <tr><td class="text-muted">LDAP uses SSL</td><td>@IDFManager.LDAP_AD_UseSSL</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </ChildContent>
    </IdfPanel>

    <IdfPanel Title="Access tester" Description="Check what the framework answers for a user, without leaving the UI.">
        <ChildContent>
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-1">User</label>
                    <select class="form-select form-select-sm" @bind="testUserId">
                        <option value="">Select a user</option>
                        @foreach (User u in users)
                        {
                            <option value="@u.Id">@u.UserName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Role</label>
                    <select class="form-select form-select-sm" @bind="testRoleId">
                        <option value="">Any</option>
                        @foreach (Role r in roles)
                        {
                            <option value="@r.Id">@r.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Entity</label>
                    <select class="form-select form-select-sm" @bind="testEntityId">
                        <option value="">Any</option>
                        @foreach (Entity e in entities)
                        {
                            <option value="@e.Id">@e.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Action</label>
                    <select class="form-select form-select-sm" @bind="testPermissionTypeId">
                        <option value="">Any</option>
                        @foreach (PermissionType p in permissionTypes)
                        {
                            <option value="@p.Id">@p.Title</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button type="button" class="btn btn-sm btn-primary" @onclick="RunTest">Run the test</button>
            </div>
            @if (testResults.Count > 0)
            {
                <ul class="list-group mt-3">
                    @foreach (string line in testResults)
                    {
                        <li class="list-group-item py-1 small font-monospace">@line</li>
                    }
                </ul>
            }
        </ChildContent>
    </IdfPanel>

    <IdfPanel Title="Maintenance">
        <ChildContent>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshStorageAsync">Reload roles and permissions cache</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshContextAsync">Reload the database context</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CreateAdministratorAsync">Create the administrator account</button>
                @if (IDFBlazorUIAdminConfig.AllowDeleteOperations)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="PurgeTokensAsync">Purge expired user tokens</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="PurgeAppAccessesAsync">Purge expired app accesses</button>
                }
            </div>
            <div class="form-text mt-2">
                Reloading the cache is needed after changing roles or permissions when
                TokenValidationMode is DecryptOnly, because the roles of a claim are resolved from that cache.
            </div>
        </ChildContent>
    </IdfPanel>

    <IdfPanel Title="Tracked sessions" Description="IDFManager.UserSessions, filled when the API tracks the sessions.">
        <ChildContent>
            @if (IDFManager.UserSessions is null || IDFManager.UserSessions.Count == 0)
            {
                <div class="text-muted">No tracked session.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>User</th><th>IP address</th><th>Created</th><th>Last connection</th><th>Expires</th></tr>
                        </thead>
                        <tbody>
                            @foreach (UserSession s in IDFManager.UserSessions)
                            {
                                <tr>
                                    <td>@UserNameOf(s.UserId)</td>
                                    <td class="small">@s.IPAddress</td>
                                    <td class="small">@s.CreateDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="small">@s.LastConnection.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="small">@s.ExpireDate.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </IdfPanel>
}

@code {
    private Dictionary<string, int> counters = new();
    private List<User> users = new();
    private List<Role> roles = new();
    private List<Entity> entities = new();
    private List<PermissionType> permissionTypes = new();

    private string testUserId = "";
    private string testRoleId = "";
    private string testEntityId = "";
    private string testPermissionTypeId = "";
    private List<string> testResults = new();

    protected override Task LoadDataAsync()
    {
        users = IdfAdminData.GetUsers(true);
        roles = IdfAdminData.GetRoles();
        entities = IdfAdminData.GetEntities();
        permissionTypes = IdfAdminData.GetPermissionTypes();

        counters = new();
        counters["Users"] = users.Count;
        counters["Roles"] = roles.Count;
        counters["Entities"] = entities.Count;
        counters["Actions"] = permissionTypes.Count;
        counters["Permissions"] = IdfAdminData.GetPermissions(null, null, null).Count;
        counters["Apps"] = IdfAdminData.GetApps(true).Count;
        counters["App accesses"] = IdfAdminData.GetAppAccesses(null, null).Count;
        counters["User tokens"] = IdfAdminData.GetUserTokens(null, true).Count;
        return Task.CompletedTask;
    }

    private static string Describe(LifeTime? lifeTime)
    {
        if (lifeTime is null) { return "not set"; }
        return lifeTime.Days + "d " + lifeTime.Hours + "h " + lifeTime.Minutes + "m";
    }

    private string UserNameOf(string userId)
    {
        User? u = users.FirstOrDefault(o => o.Id == userId);
        return u is null ? Shorten(userId, 12) : u.UserName;
    }

    private void RunTest()
    {
        ClearMessages();
        testResults = new();
        if (string.IsNullOrEmpty(testUserId))
        {
            AddError("Select a user first");
            return;
        }

        try
        {
            if (!string.IsNullOrEmpty(testRoleId))
            {
                bool hasRole = IDFManager.userService.ValidateUserRole(testUserId, testRoleId);
                testResults.Add("ValidateUserRole(user, " + testRoleId + ") = " + hasRole);
            }

            if (!string.IsNullOrEmpty(testEntityId) && !string.IsNullOrEmpty(testPermissionTypeId))
            {
                bool hasPermission = IDFManager.userService.ValidateUserPermission(testUserId, testEntityId, testPermissionTypeId);
                testResults.Add("ValidateUserPermission(user, " + testEntityId + ", " + testPermissionTypeId + ") = " + hasPermission);
            }

            if (!string.IsNullOrEmpty(testEntityId) && string.IsNullOrEmpty(testPermissionTypeId))
            {
                List<PermissionType> allowed = IDFManager.userService.GetUserEntityPermissions(testUserId, testEntityId);
                testResults.Add("GetUserEntityPermissions(user, " + testEntityId + ") = "
                    + (allowed.Count == 0 ? "none" : string.Join(", ", allowed.Select(o => o.Id))));
            }

            List<Role> userRoles = IdfAdminData.GetUserRoles(testUserId);
            testResults.Add("GetRoles(user) = " + (userRoles.Count == 0 ? "none" : string.Join(", ", userRoles.Select(o => o.Id))));
        }
        catch (Exception ex)
        {
            AddError(ex);
        }
    }

    private async Task RefreshStorageAsync()
    {
        await ExecuteAsync(() => IDFManager.RefreshIDFStorage(), "Roles and permissions cache reloaded");
    }

    private async Task RefreshContextAsync()
    {
        await ExecuteAsync(() => IDFManager.RefreshIDFDBContext(), "Database context reloaded");
    }

    private async Task CreateAdministratorAsync()
    {
        await ExecuteAsync(() => IDFManager.CreateAdministrator(), "Administrator account checked");
    }

    private async Task PurgeTokensAsync()
    {
        int removed = 0;
        bool ok = await ExecuteAsync(() => { removed = IDFManager.userTokenService.CleanExpiredUserTokens(); }, "Expired tokens removed");
        if (ok) { SetSuccess(removed + " expired token(s) removed"); }
    }

    private async Task PurgeAppAccessesAsync()
    {
        int removed = 0;
        bool ok = await ExecuteAsync(() => { removed = IDFManager.appAccessService.CleanExpiredAppAccesss(); }, "Expired app accesses removed");
        if (ok) { SetSuccess(removed + " expired app access(es) removed"); }
    }
}
