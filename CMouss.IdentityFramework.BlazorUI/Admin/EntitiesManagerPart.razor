@namespace CMouss.IdentityFramework.BlazorUI.Admin
@inherits IdfAdminComponentBase

@if (!IsReady)
{
    <div class="text-muted p-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading entities...</div>
}
else if (!IsAuthorized)
{
    <div class="alert alert-warning">You are not allowed to manage entities.</div>
}
else
{
    <IdfPanel Title="Entities" Description="An entity is a protected resource of your application, for example User, Invoice or Report." IsLoading="IsLoading">
        <Toolbar>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync">Refresh</button>
            <button type="button" class="btn btn-sm btn-primary" @onclick="OpenCreate">New entity</button>
        </Toolbar>
        <ChildContent>

            <IdfAlerts Errors="Errors" SuccessMessage="@SuccessMessage" OnDismiss="ClearMessages" />

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Title</th>
                            <th>Permissions</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (entities.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No entity defined yet.</td></tr>
                        }
                        @foreach (Entity e in entities)
                        {
                            <tr>
                                <td class="font-monospace small">@e.Id</td>
                                <td class="fw-semibold">@e.Title</td>
                                <td>@PermissionCount(e.Id)</td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(e)">Edit</button>
                                    @if (IDFBlazorUIAdminConfig.AllowDeleteOperations)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(e)">Delete</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </ChildContent>
    </IdfPanel>

    <IdfModal Visible="showEditor" Title="@(isNew ? "New entity" : "Edit entity")" Size="" OnClose="CloseEditor">
        <ChildContent>
            <div class="mb-3">
                <label class="form-label">Id</label>
                <input class="form-control" @bind="editorId" disabled="@(!isNew)" />
                <div class="form-text">The Id is the value used in the code, for example ValidateUserPermission(userId, "Invoice", "Create").</div>
            </div>
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input class="form-control" @bind="editorTitle" />
            </div>
            <IdfAlerts Errors="editorErrors" />
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseEditor">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveAsync">Save</button>
        </Footer>
    </IdfModal>

    <IdfConfirm Visible="showDeleteConfirm"
                Title="Delete entity"
                Message="@("Delete the entity " + selectedTitle + " ?")"
                Details="Every permission granted on this entity is removed too."
                OnConfirm="DeleteAsync"
                OnCancel="() => showDeleteConfirm = false" />
}

@code {
    private List<Entity> entities = new();
    private Dictionary<string, int> permissionCounts = new();

    private bool showEditor;
    private bool isNew;
    private string editorId = "";
    private string editorTitle = "";
    private List<string> editorErrors = new();

    private bool showDeleteConfirm;
    private string selectedId = "";
    private string selectedTitle = "";

    protected override Task LoadDataAsync()
    {
        entities = IdfAdminData.GetEntities();
        permissionCounts = new();
        foreach (Entity e in entities)
        {
            permissionCounts[e.Id] = IdfAdminData.GetPermissions(null, e.Id, null).Count;
        }
        return Task.CompletedTask;
    }

    private int PermissionCount(string entityId)
    {
        return permissionCounts.ContainsKey(entityId) ? permissionCounts[entityId] : 0;
    }

    private void OpenCreate()
    {
        ClearMessages();
        editorErrors = new();
        isNew = true;
        editorId = "";
        editorTitle = "";
        showEditor = true;
    }

    private void OpenEdit(Entity e)
    {
        ClearMessages();
        editorErrors = new();
        isNew = false;
        editorId = e.Id;
        editorTitle = e.Title;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        editorErrors = new();
    }

    private async Task SaveAsync()
    {
        editorErrors = new();
        if (string.IsNullOrWhiteSpace(editorId)) { editorErrors.Add("Id is required"); }
        if (string.IsNullOrWhiteSpace(editorTitle)) { editorErrors.Add("Title is required"); }
        if (editorErrors.Count > 0) { return; }

        bool ok;
        if (isNew)
        {
            if (entities.Any(o => string.Equals(o.Id, editorId, StringComparison.OrdinalIgnoreCase)))
            {
                editorErrors.Add("This Id already exists");
                return;
            }
            ok = await ExecuteAsync(() => IDFManager.entityService.Create(editorId, editorTitle), "Entity created");
        }
        else
        {
            ok = await ExecuteAsync(() => IDFManager.entityService.Update(editorId, editorTitle), "Entity updated");
        }

        if (ok) { showEditor = false; }
        else { editorErrors = new List<string>(Errors); }
    }

    private void AskDelete(Entity e)
    {
        ClearMessages();
        selectedId = e.Id;
        selectedTitle = e.Title;
        showDeleteConfirm = true;
    }

    private async Task DeleteAsync()
    {
        showDeleteConfirm = false;
        bool ok = await ExecuteAsync(() => IdfAdminData.DeleteEntity(selectedId), "Entity deleted");
        if (ok) { IDFManager.RefreshIDFStorage(); }
    }
}
