@namespace CMouss.IdentityFramework.BlazorUI.Admin
@inherits IdfAdminComponentBase

@* Single component hosting every Identity Framework management screen. *@

@if (!IsReady)
{
    <div class="text-muted p-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>
}
else if (!IsAuthorized)
{
    <div class="alert alert-warning">
        <div class="fw-semibold">Access denied</div>
        <div class="small">
            @if (CurrentUser is null)
            {
                <span>You are not signed in.</span>
            }
            else
            {
                <span>
                    @CurrentUser.UserName does not hold any of the roles allowed to manage the identity framework
                    (@string.Join(", ", IDFBlazorUIAdminConfig.GetAdminRoleIds())).
                </span>
            }
        </div>
    </div>
}
else if (tabs.Count == 0)
{
    <div class="alert alert-secondary">
        <div class="fw-semibold">Nothing to manage</div>
        <div class="small">Every management section of this component has been disabled by the host application.</div>
    </div>
}
else
{
    <div class="idf-admin">
        <ul class="nav nav-tabs mb-3">
            @foreach (KeyValuePair<string, string> tab in tabs)
            {
                string key = tab.Key;
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == key ? "active" : "")" @onclick="() => SetTab(key)">
                        @tab.Value
                    </button>
                </li>
            }
        </ul>

        @switch (activeTab)
        {
            case "users":
                <UsersManagerPart RequireAdminRole="RequireAdminRole" />
                break;
            case "roles":
                <RolesManagerPart RequireAdminRole="RequireAdminRole" />
                break;
            case "entities":
                <EntitiesManagerPart RequireAdminRole="RequireAdminRole" />
                break;
            case "actions":
                <PermissionTypesManagerPart RequireAdminRole="RequireAdminRole" />
                break;
            case "permissions":
                <PermissionsManagerPart RequireAdminRole="RequireAdminRole" />
                break;
            case "apps":
                <AppsManagerPart RequireAdminRole="RequireAdminRole" />
                break;
            case "apppermissiontypes":
                <AppPermissionTypesManagerPart RequireAdminRole="RequireAdminRole" />
                break;
            case "appaccesses":
                <AppAccessManagerPart RequireAdminRole="RequireAdminRole" />
                break;
            case "tokens":
                <UserTokensManagerPart RequireAdminRole="RequireAdminRole" />
                break;
            case "attributes":
                <AttributeTypesManagerPart RequireAdminRole="RequireAdminRole" />
                break;
            case "system":
                <MaintenancePart RequireAdminRole="RequireAdminRole" />
                break;
        }
    </div>
}

@code {
    /// <summary>
    /// Tab opened first: users, roles, entities, actions, permissions, apps,
    /// apppermissiontypes, appaccesses, tokens, attributes or system.
    /// When that tab is disabled, the first enabled one is opened instead.
    /// </summary>
    [Parameter] public string DefaultTab { get; set; } = "users";

    #region Disabled sections

    /// <summary>When true, the Users tab is not displayed.</summary>
    [Parameter] public bool DisableUsers { get; set; } = false;

    /// <summary>When true, the Roles tab is not displayed.</summary>
    [Parameter] public bool DisableRoles { get; set; } = false;

    /// <summary>When true, the Entities tab is not displayed.</summary>
    [Parameter] public bool DisableEntities { get; set; } = false;

    /// <summary>When true, the Actions (permission types) tab is not displayed.</summary>
    [Parameter] public bool DisableActions { get; set; } = false;

    /// <summary>When true, the Permissions tab (role x entity x action) is not displayed.</summary>
    [Parameter] public bool DisablePermissions { get; set; } = false;

    /// <summary>When true, the Apps tab is not displayed.</summary>
    [Parameter] public bool DisableApps { get; set; } = false;

    /// <summary>When true, the App permissions tab (app permission types) is not displayed.</summary>
    [Parameter] public bool DisableAppPermissions { get; set; } = false;

    /// <summary>When true, the App accesses tab is not displayed.</summary>
    [Parameter] public bool DisableAppAccesses { get; set; } = false;

    /// <summary>When true, the User tokens tab is not displayed.</summary>
    [Parameter] public bool DisableUserTokens { get; set; } = false;

    /// <summary>When true, the Attributes tab is not displayed.</summary>
    [Parameter] public bool DisableAttributes { get; set; } = false;

    /// <summary>When true, the System (maintenance) tab is not displayed.</summary>
    [Parameter] public bool DisableSystem { get; set; } = false;

    #endregion

    private static readonly List<KeyValuePair<string, string>> AllTabs = new()
    {
        new("users", "Users"),
        new("roles", "Roles"),
        new("entities", "Entities"),
        new("actions", "Actions"),
        new("permissions", "Permissions"),
        new("apps", "Apps"),
        new("apppermissiontypes", "App permissions"),
        new("appaccesses", "App accesses"),
        new("tokens", "User tokens"),
        new("attributes", "Attributes"),
        new("system", "System")
    };

    private Dictionary<string, string> tabs = new();
    private string activeTab = "";

    protected override void OnParametersSet()
    {
        tabs = BuildTabs();

        //Keep the tab the user selected, unless it has just been disabled
        if (String.IsNullOrEmpty(activeTab) || !tabs.ContainsKey(activeTab))
        {
            activeTab = ResolveDefaultTab();
        }

        base.OnParametersSet();
    }

    private Dictionary<string, string> BuildTabs()
    {
        Dictionary<string, string> result = new();
        foreach (KeyValuePair<string, string> tab in AllTabs)
        {
            if (IsTabEnabled(tab.Key)) { result.Add(tab.Key, tab.Value); }
        }
        return result;
    }

    private bool IsTabEnabled(string key)
    {
        switch (key)
        {
            case "users": return !DisableUsers;
            case "roles": return !DisableRoles;
            case "entities": return !DisableEntities;
            case "actions": return !DisableActions;
            case "permissions": return !DisablePermissions;
            case "apps": return !DisableApps;
            case "apppermissiontypes": return !DisableAppPermissions;
            case "appaccesses": return !DisableAppAccesses;
            case "tokens": return !DisableUserTokens;
            case "attributes": return !DisableAttributes;
            case "system": return !DisableSystem;
            default: return false;
        }
    }

    private string ResolveDefaultTab()
    {
        if (tabs.Count == 0) { return ""; }

        string requested = String.IsNullOrEmpty(DefaultTab) ? "users" : DefaultTab.Trim().ToLower();
        if (tabs.ContainsKey(requested)) { return requested; }

        //The requested tab is unknown or disabled, fall back to the first one still available
        return tabs.Keys.First();
    }

    private void SetTab(string tab)
    {
        if (!tabs.ContainsKey(tab)) { return; }
        activeTab = tab;
    }
}
